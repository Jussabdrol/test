{
  "name": "bop",
  "version": "2.0.0",
  "description": "BOP (Business Orchestration Platform) — multi-tenant compliance management",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/build-client.js",
    "prestart": "npm run build",
    "start": "node server.js",
    "dev": "npm run build && node --env-file=.env server.js",
    "pretest": "npm run build",
    "test": "node --require ./test/support/isolate-env.js --test --test-timeout=60000 test/unit/*.test.js test/integration/*.test.js",
    "lint": "eslint .",
    "check": "npm run build && node scripts/check-syntax.js && npm run lint",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "@turbodocx/html-to-docx": "1.23.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "mammoth": "^1.12.0",
    "multer": "^2.0.2",
    "openai": "^6.27.0",
    "pg": "^8.11.3",
    "sanitize-html": "2.17.7",
    "stripe": "22.6.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "eslint": "10.10.0",
    "globals": "17.12.0"
  }
}
