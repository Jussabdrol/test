# Let The Framework - Environment Configuration
# Copy this file to .env and adjust values for your environment

# =============================================================================
# Database Configuration
# =============================================================================

# Database type: 'sqlite' (local dev) or 'postgresql' (production/docker)
DB_TYPE=sqlite

# PostgreSQL settings (only used when DB_TYPE=postgresql)
DB_HOST=localhost
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=localdev123
DB_NAME=lettheframework

# Cloud SQL connection (for GCP Cloud Run - automatically set by Cloud Run)
# CLOUD_SQL_CONNECTION_NAME=your-project:region:instance-name

# =============================================================================
# Server Configuration
# =============================================================================

# Port to run the server on
PORT=8080

# =============================================================================
# Quick Start Commands
# =============================================================================
#
# Local development with SQLite (default):
#   npm run dev
#
# Local development with PostgreSQL:
#   docker-compose up -d postgres    # Start PostgreSQL container
#   npm run dev:pg                   # Run app with PostgreSQL
#
# Full containerized testing:
#   docker-compose --profile full up
#
# Production verification on Cloud Run:
#   gcloud builds submit            # Deploy to Cloud Run (scale-to-zero)
