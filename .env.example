# BOP - Environment Configuration
# Copy this file to .env and adjust values for your environment

# =============================================================================
# AI Agent
# =============================================================================
# OpenAI API key – required for the AI Agent chat module
# Get yours at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# =============================================================================
# Supabase Configuration
# =============================================================================

# Supabase project URL & anon key (used for Auth and Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (for admin operations – keeps RLS bypass server-side)
# Find this in Supabase Dashboard → Settings → API → service_role key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase PostgreSQL connection string (direct or pooler)
# Find this in Supabase Dashboard → Settings → Database → Connection string → URI
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Or provide individual connection pieces instead of SUPABASE_DB_URL:
# SUPABASE_DB_HOST=aws-0-eu-central-1.pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_USER=postgres.[ref]
# SUPABASE_DB_PASSWORD=your-password
# SUPABASE_DB_NAME=postgres

# Connection pool size (default 20 for persistent server)
# DB_POOL_MAX=20

# =============================================================================
# Server Configuration
# =============================================================================

# Port to run the server on
PORT=3000

# Secret used to sign session tokens.
# REQUIRED in production: must be at least 32 characters; the server refuses
# to boot without it when NODE_ENV=production.
# Generate with: openssl rand -hex 48
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# =============================================================================
# Multi-Tenant / MSP Configuration
# =============================================================================

# Default superadmin email (created on first boot if no users exist)
# SUPERADMIN_EMAIL=admin@example.com

# Default organization name for single-tenant installs (optional)
# DEFAULT_ORG_NAME=My Organization

# =============================================================================
# Quick Start
# =============================================================================
#
# 1. Read database/README.md and apply reviewed migrations before startup.
# 2. Use a dedicated development Supabase project; create a private uploads bucket.
# 3. Review the actual schema, grants and RLS for that project.
#    database/legacy/*.sql is historical reference, not a setup sequence.
# 4. Copy this file to .env and fill in development values.
# 5. npm ci --ignore-scripts && npm run dev
#    For isolated verification without any cloud account: npm run verify

# Optional PEM CA for verified PostgreSQL TLS; public CAs use Node trust roots.
# SUPABASE_DB_CA=
